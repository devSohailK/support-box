# SITE_ADDRESS=:80 locally (plain HTTP); set to a hostname in production for automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy app:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
}
