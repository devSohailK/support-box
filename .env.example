# Copy to .env and fill in. Never commit .env.
# Settings marked (step N) are not used yet; they are listed so the file stays complete.

# --- App ---
NODE_ENV=production
PORT=3000
# Inside Docker this is overridden to /data/app.db (a named volume).
DATABASE_PATH=

# --- Web / Caddy ---
# :80 for local HTTP. In production use a hostname, e.g. 203-0-113-10.sslip.io, for automatic HTTPS.
SITE_ADDRESS=
HTTP_PORT=

# --- Auth (step 2) ---
# Long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=local-dev-only-session-secret-replace-in-prod
# true behind HTTPS (production); false for local plain-HTTP runs.
COOKIE_SECURE=false
# role:email:name, comma separated. Created on first start only; existing users are never changed.
SEED_USERS=admin:sara@team.local:Sara,agent:ali@team.local:Ali,agent:maya@team.local:Maya,agent:omar@team.local:Omar
SEED_PASSWORD=change-me

# --- Webhook ---
# Shared secret sent as the X-Webhook-Secret header (min 16 chars), e.g. `openssl rand -hex 24`.
WEBHOOK_SECRET=local-dev-only-webhook-secret

# --- AI ---
# Any OpenAI-compatible chat completions API. Default: DeepSeek.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=700

# --- Mail ---
# demo = deliver to the Mailpit container (nothing leaves the box; view at http://localhost:8025).
#        Only mailpit/localhost are accepted as SMTP_HOST in demo mode.
# production = real SMTP. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#        SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char app password>, SMTP_FROM="Support <you@gmail.com>"
#        (app passwords need 2-Step Verification: myaccount.google.com/apppasswords)
MAIL_MODE=demo
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Support <support@team.local>
# Optional: where customer replies go, e.g. you+support@gmail.com so they get the support label.
SMTP_REPLY_TO=
